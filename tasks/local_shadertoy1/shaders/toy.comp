#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform image2D resultImage;

layout(push_constant) uniform PushConstants {
  vec2  iResolution;
  float iTime;
} pc;

vec3 eye        = vec3(0.0, 0.0, 3.0);
vec3 baseColor  = vec3(1.0, 0.2, 0.2);
vec3 light      = vec3(5.0, 5.0, 5.0);
vec3 lightColor = vec3(1.0);

float sdSphere(vec3 p, vec3 c, float r) {
    return length(p - c) - r + 0.1 * sin(pc.iTime);
}

float smin(float a, float b, float k) {
    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

float sdf(in vec3 p) {
    float s1 = sdSphere(p, vec3(-0.8, 0.0, 0.0), 0.7);
    float s2 = sdSphere(p, vec3( 0.8, 0.0, 0.0), 0.7);

    float angle = pc.iTime * 0.8;
    vec3  c3    = vec3(cos(angle) * 1.6, sin(angle) * 1.6, 0.0);
    float s3    = sdSphere(p, c3, 0.55);

    float d = smin(s1, s2, 0.4);
    d = smin(d, s3, 0.4);
    return d;
}

vec3 calcNormal(in vec3 p) {
    vec2 e = vec2(0.001, 0.0);
    return normalize(vec3(
        sdf(p + e.xyy) - sdf(p - e.xyy),
        sdf(p + e.yxy) - sdf(p - e.yxy),
        sdf(p + e.yyx) - sdf(p - e.yyx)
    ));
}

vec3 trace(in vec3 from, in vec3 dir, out bool hit) {
    vec3 p = from;
    hit = false;

    float totalDist = 0.0;
    for (int steps = 0; steps < 10000; steps++) {
        float dist = sdf(p);
        if (dist < 0.01) { hit = true; break; }
        totalDist += dist;
        if (totalDist > 1000.0) break;
        p += dist * dir;
    }
    return p;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    
    if (coord.x >= int(pc.iResolution.x) || coord.y >= int(pc.iResolution.y))
        return;

    vec2 fragCoord = vec2(float(coord.x), pc.iResolution.y - float(coord.y));

    vec2 scale = 9.0 * pc.iResolution / max(pc.iResolution.x, pc.iResolution.y);
    vec2 uv    = scale * ((fragCoord / pc.iResolution) - vec2(0.5, 0.5));

    vec3 dir = normalize(vec3(uv, 0.0) - eye);

    bool hit;
    vec3 p = trace(eye, dir, hit);

    vec3 col = vec3(0.05, 0.07, 0.10);
    if (hit) {
        vec3 n = calcNormal(p);
        vec3 l = normalize(light - p);
        vec3 v = normalize(eye - p);
        vec3 r = reflect(-l, n);

        float ambient  = 0.1;
        float diffuse  = max(dot(n, l), 0.0);
        float specular = pow(max(dot(r, v), 0.0), 64.0);

        col = baseColor * (ambient + diffuse) * lightColor
            + lightColor * specular;
    }

    imageStore(resultImage, coord, vec4(col, 1.0));
}