#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, r32f) uniform image2D heightmap;
layout(set = 0, binding = 1, std430) buffer MaxHeight
{
    uint value;
} maxHeight;

layout(push_constant) uniform params_t
{
    int seed;
    int octaves;
    float frequency;
    float persistence;
    float lacunarity;
    float islandFalloff;
    int normalize;
    int padding;
} params;

uint hash2D(uint x, uint y, uint seed)
{
    uint hash = seed ^ (x * 0x8da6b343u) ^ (y * 0xd8163841u);
    hash ^= hash >> 16;
    hash *= 0x7feb352du;
    hash ^= hash >> 15;
    hash *= 0x846ca68bu;
    hash ^= hash >> 16;
    return hash;
}

float fade(float value)
{
    return value * value * value *
        (value * (value * 6.0 - 15.0) + 10.0);
}

float gradient(uint x, uint y, uint seed, float dx, float dy)
{
    const float diagonal = 0.70710678;
    const vec2 gradients[8] = vec2[](
        vec2( 1.0,  0.0),
        vec2(-1.0,  0.0),
        vec2( 0.0,  1.0),
        vec2( 0.0, -1.0),
        vec2( diagonal,  diagonal),
        vec2( diagonal, -diagonal),
        vec2(-diagonal,  diagonal),
        vec2(-diagonal, -diagonal)
    );
    return dot(gradients[hash2D(x, y, seed) & 7u], vec2(dx, dy));
}

float perlin(float x, float y, uint seed)
{
    int floorX = int(floor(x));
    int floorY = int(floor(y));
    uint x0 = uint(floorX);
    uint y0 = uint(floorY);
    float localX = x - float(floorX);
    float localY = y - float(floorY);

    float bottom = mix(
        gradient(x0, y0, seed, localX, localY),
        gradient(x0 + 1u, y0, seed, localX - 1.0, localY),
        fade(localX)
    );
    float top = mix(
        gradient(x0, y0 + 1u, seed, localX, localY - 1.0),
        gradient(x0 + 1u, y0 + 1u, seed, localX - 1.0, localY - 1.0),
        fade(localX)
    );
    return mix(bottom, top, fade(localY)) * 1.41421356;
}

float generateHeight(ivec2 pixel, ivec2 size)
{
    vec2 position =
        (vec2(pixel) / vec2(size - 1) - 0.5) * 2.0;
    float amplitude = 1.0;
    float frequency = params.frequency;
    float noise = 0.0;
    float amplitudeSum = 0.0;

    for (int octave = 0; octave < params.octaves; ++octave)
    {
        noise += amplitude * perlin(
            position.x * frequency,
            position.y * frequency,
            uint(params.seed)
        );
        amplitudeSum += amplitude;
        amplitude *= params.persistence;
        frequency *= params.lacunarity;
    }

    float distanceFromCenter = length(position);
    float islandMask = pow(
        clamp(1.0 - distanceFromCenter, 0.0, 1.0),
        params.islandFalloff
    );
    float normalizedNoise = noise / amplitudeSum * 0.5 + 0.5;
    return clamp(normalizedNoise * islandMask, 0.0, 1.0);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(heightmap);
    if (any(greaterThanEqual(pixel, size)))
        return;

    if (params.normalize == 0)
    {
        float height = generateHeight(pixel, size);
        imageStore(heightmap, pixel, vec4(height));
        atomicMax(maxHeight.value, floatBitsToUint(height));
        return;
    }

    float maximum = uintBitsToFloat(maxHeight.value);
    float height = imageLoad(heightmap, pixel).r;
    imageStore(
        heightmap,
        pixel,
        vec4(maximum > 0.0 ? height / maximum : 0.0)
    );
}
